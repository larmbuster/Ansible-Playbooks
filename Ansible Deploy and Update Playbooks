---
- name: Deploy and execute a playbook on a remote target
  hosts: target_hosts  # 🔧 Replace with your inventory group or host
  become: true          # 🔧 Enable if the remote playbook needs elevated privileges
  gather_facts: no      # 🚫 Skipping facts for speed since we don't need them here

  vars:
    # 📁 Local playbook path to deploy
    local_playbook_path: "/local/path/to/playbook.yml"

    # 📁 Where to copy the playbook on the remote target
    remote_playbook_path: "/tmp/remote_playbook.yml"

    # 📁 Local directory (on control node) to store JSON logs
    log_dir: "/tmp/remote_playbook_logs"

    # 📄 Per-host JSON log file
    log_file: "{{ log_dir }}/execution_{{ inventory_hostname }}.json"

    # 🌐 Centralized log options — choose one method below
    central_log_dir: "/mnt/shared/logs"   # For file-based collection
    use_http_post: false                  # Toggle this to true to use REST API instead
    central_log_api_url: "http://log-server.local/api/remote-exec-logs"

  pre_tasks:

    - name: Ensure log directory exists on control node
      ansible.builtin.file:
        path: "{{ log_dir }}"
        state: directory
        mode: '0755'
      delegate_to: localhost
      run_once: true

    - name: Check if playbook exists on remote host
      ansible.builtin.stat:
        path: "{{ remote_playbook_path }}"
      register: playbook_stat

    - name: Calculate checksum of the local playbook
      ansible.builtin.set_fact:
        local_checksum: "{{ lookup('file', local_playbook_path) | checksum }}"
      delegate_to: localhost
      run_once: true

    - name: Copy playbook if missing or changed
      ansible.builtin.copy:
        src: "{{ local_playbook_path }}"
        dest: "{{ remote_playbook_path }}"
        mode: '0644'
      delegate_to: localhost
      when: playbook_stat.stat.exists == false or playbook_stat.stat.checksum != local_checksum

  tasks:

    - name: Execute the playbook on the remote system
      ansible.builtin.command:
        cmd: "ansible-playbook {{ remote_playbook_path }}"
      register: execution_result
      changed_when: false  # Prevent false "changed" reports
      ignore_errors: false # Fail task if execution fails

    - name: Create JSON-formatted log on control node
      ansible.builtin.copy:
        dest: "{{ log_file }}"
        content: |
          {
            "host": "{{ inventory_hostname }}",
            "success": {{ execution_result.rc == 0 | to_json }},
            "return_code": {{ execution_result.rc }},
            "stdout_lines": {{ execution_result.stdout_lines | to_json }},
            "stderr": {{ execution_result.stderr | default('') | to_json }},
            "timestamp": "{{ ansible_date_time.iso8601 }}"
          }
        mode: '0644'
        force: true
      delegate_to: localhost

    - name: Copy log file to central log server (file-based method)
      ansible.builtin.copy:
        src: "{{ log_file }}"
        dest: "{{ central_log_dir }}/"
      when: not use_http_post
      delegate_to: localhost

    - name: Send log to central server via HTTP POST (API method)
      ansible.builtin.uri:
        url: "{{ central_log_api_url }}"
        method: POST
        headers:
          Content-Type: "application/json"
        body: "{{ lookup('file', log_file) }}"
        status_code: 200
      when: use_http_post
      delegate_to: localhost
