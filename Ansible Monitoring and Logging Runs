---
- name: Enable Ansible Logging with Best Practices
  hosts: localhost
  gather_facts: false
  become: true  # Required to modify system files like /etc/ansible/ansible.cfg and create log files

  vars:
    ansible_cfg_path: "/etc/ansible/ansible.cfg"           # Location of Ansible config file
    ansible_log_path: "/var/log/ansible/ansible.log"       # Path where Ansible should write logs
    log_dir: "/var/log/ansible"                            # Directory for Ansible and JSON logs
    json_log_file: "{{ log_dir }}/ansible_logging_setup_{{ inventory_hostname }}.log"
    log_line: "log_path = {{ ansible_log_path }}"          # The line to insert/update in ansible.cfg

  pre_tasks:

    # Create the logging directory if it doesn't exist
    - name: Ensure log directory exists
      ansible.builtin.file:
        path: "{{ log_dir }}"
        state: directory
        mode: '0755'

    # Ensure the actual log file exists and has proper permissions
    - name: Ensure Ansible log file exists and is writable
      ansible.builtin.file:
        path: "{{ ansible_log_path }}"
        state: touch
        mode: '0644'
        owner: root
        group: root

  tasks:

    # Backup ansible.cfg in case anything goes wrong
    - name: Backup existing ansible.cfg (if exists)
      ansible.builtin.copy:
        src: "{{ ansible_cfg_path }}"
        dest: "{{ ansible_cfg_path }}.bak"
        remote_src: true
      ignore_errors: true

    # Add or update the log_path setting under [defaults] in ansible.cfg
    - name: Configure ansible.cfg logging
      ansible.builtin.lineinfile:
        path: "{{ ansible_cfg_path }}"
        regexp: "^log_path\s*="                            # Match existing log_path if present
        line: "{{ log_line }}"                             # Line to write/replace
        state: present
        insertafter: '[defaults]'                          # Ensure placement in the right section
        create: false
        backup: true
      register: log_config_result

    # Write a JSON-formatted log of this configuration task for auditing/tracking
    - name: Log configuration result to JSON
      ansible.builtin.copy:
        dest: "{{ json_log_file }}"
        content: |
          {
            "status": "{{ 'changed' if log_config_result.changed else 'ok' }}",
            "host": "{{ inventory_hostname }}",
            "log_line_added": "{{ log_line }}",
            "ansible_cfg_path": "{{ ansible_cfg_path }}",
            "timestamp": "{{ ansible_date_time.iso8601 }}"
          }
        mode: '0644'

  post_tasks:

    # Provide human-readable confirmation at the end of the play
    - name: Show status
      ansible.builtin.debug:
        msg: "✅ Logging has been configured in {{ ansible_cfg_path }}. Output goes to {{ ansible_log_path }}"
