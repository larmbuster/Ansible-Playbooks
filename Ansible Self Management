---
- name: Ansible Self-Management Playbook (Best Practices)
  hosts: localhost
  become: true
  gather_facts: true

  vars:
    ansible_log_path: "/var/log/ansible/ansible.log"
    ansible_cfg: "/etc/ansible/ansible.cfg"
    inventory_file: "/etc/ansible/hosts"
    remote_playbook_path: "/remote/path/playbook.yml"
    local_playbook_path: "/local/path/to/playbook.yml"
    lint_target: "/path/to/playbook.yml"
    json_log_path: "/var/log/ansible/self_mgmt_log_{{ inventory_hostname }}.json"

  pre_tasks:

    - name: 🗂️ Ensure log directory exists
      ansible.builtin.file:
        path: "{{ ansible_log_path | dirname }}"
        state: directory
        mode: '0755'

    - name: 📁 Ensure ansible log file exists
      ansible.builtin.file:
        path: "{{ ansible_log_path }}"
        state: touch
        mode: '0644'

    - name: 🛡️ Enable Ansible logging in ansible.cfg
      ansible.builtin.lineinfile:
        path: "{{ ansible_cfg }}"
        regexp: '^log_path\s*='
        line: "log_path = {{ ansible_log_path }}"
        insertafter: '[defaults]'
        create: false
        backup: true

  tasks:

    - name: 📦 Install Ansible using best available method
      block:
        - name: 🐧 Install via APT (Debian)
          ansible.builtin.apt:
            name: ansible
            state: present
            update_cache: true
          when: ansible_os_family == "Debian"

        - name: 🦀 Install via DNF (RHEL)
          ansible.builtin.dnf:
            name: ansible
            state: present
          when: ansible_os_family == "RedHat"

        - name: 🐍 Fallback to pip install if package manager fails
          ansible.builtin.pip:
            name: ansible
            state: present
          when: ansible_facts.packages.ansible is not defined
      rescue:
        - name: ❗ Log failure to install Ansible
          ansible.builtin.debug:
            msg: "Ansible installation failed on {{ ansible_distribution }}"

    - name: 🛠️ Generate dynamic inventory file
      ansible.builtin.copy:
        dest: "{{ inventory_file }}"
        content: |
          # {{ ansible_managed }}
          [web_servers]
          web1.example.com
          web2.example.com

          [db_servers]
          db1.example.com
          db2.example.com
        mode: '0644'
        owner: root
        group: root
        backup: true

    - name: 🚚 Copy remote playbook
      ansible.builtin.copy:
        src: "{{ local_playbook_path }}"
        dest: "{{ remote_playbook_path }}"
        owner: root
        group: root
        mode: '0644'

    - name: ▶️ Run remote playbook
      ansible.builtin.command:
        cmd: "ansible-playbook {{ remote_playbook_path }}"
      register: remote_run_result
      changed_when: false

    - name: 📡 Run ad-hoc ping across all hosts
      ansible.builtin.command:
        cmd: "ansible all -m ping"
      register: ad_hoc_ping
      changed_when: false

    - name: 🔍 Lint the playbook
      ansible.builtin.command:
        cmd: "ansible-lint {{ lint_target }}"
      register: lint_result
      changed_when: false
      failed_when: lint_result.rc != 0

  post_tasks:

    - name: 🧾 Log result summary in JSON
      ansible.builtin.copy:
        dest: "{{ json_log_path }}"
        content: |
          {
            "status": "completed",
            "host": "{{ inventory_hostname }}",
            "ansible_installed": true,
            "remote_playbook_ran": "{{ remote_run_result.rc == 0 }}",
            "ping_successful": "{{ 'SUCCESS' in ad_hoc_ping.stdout | default('') }}",
            "lint_passed": "{{ lint_result.rc == 0 }}",
            "timestamp": "{{ ansible_date_time.iso8601 }}"
          }
        mode: '0644'
